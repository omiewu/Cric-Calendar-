# CRIC_API_KEY: Optional CricketData.org (CricAPI) key for live international cricket fixtures.
# Configure this via the Secrets panel in AI Studio or inside the app Settings dialog.
# CricPulse also ships with a complete built-in current-year international fixture schedule
# so the app works immediately out of the box without a live key.
CRIC_API_KEY=YOUR_CRICAPI_KEY
